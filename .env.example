GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_PREMIUM=gemini-3.5-flash

# Payment links (Selar)
NEXT_PUBLIC_PAYLINK_SOLO=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_PAYLINK_PRO=https://selar.com/57plan?currency=USD
